{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Replay scenario",
  "type": "object",
  "required": [
    "version",
    "id",
    "name",
    "view",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "view": {
      "type": "object",
      "required": [
        "longitude",
        "latitude",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "heading": {
          "type": "number",
          "minimum": 0,
          "maximum": 360,
          "default": 0
        },
        "pitch": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "default": -90
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
